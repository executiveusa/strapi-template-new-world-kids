# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM proxy (optional)
NVIDIA_NIM_BASE_URL=http://localhost:8082
NVIDIA_NIM_API_KEY=dummy
NVIDIA_NIM_MODEL=moonshotai/kimi-k2-thinking

# Public site visibility. live = whole site; coming-soon = only /coming-soon is public.
# Unset: coming-soon in production, live in development.
SITE_MODE=
# Team preview: open /preview?key=<PREVIEW_KEY> once to see the full site while it is hidden.
PREVIEW_KEY=
# Public address of the site, used for canonical links, the sitemap, and sharing images.
APP_PUBLIC_URL=http://localhost:3000
# Forms write through the service role (server only; never commit it).
# The New World Kids tables live in Supabase project cyxdevcjycmffhmwxojh (schema nwkids).
